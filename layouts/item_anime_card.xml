<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirai · anime poster card for rails (Home / Explore / Related / Search).
  2:3 poster, score badge, title, subtitle. Flat + border (no glow).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@id/animeCard"
    style="@style/Widget.Mirai.CardView.Media"
    android:layout_width="@dimen/poster_width_l"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_m">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@id/animeCardPosterWrap"
            android:layout_width="match_parent"
            android:layout_height="@dimen/poster_height_l"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@id/animeCardPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:src="@tools:sample/avatars" />

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="bottom"
                android:background="@drawable/mirai_scrim_media_bottom" />

            <TextView
                android:id="@id/animeCardScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_sm"
                android:background="@drawable/mirai_bg_chip_rating"
                android:drawablePadding="2dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Mirai.Caption"
                android:textColor="@color/mirai_on_rating_container"
                app:drawableStartCompat="@drawable/mirai_ic_star"
                app:drawableTint="@color/mirai_rating"
                tools:text="8.9" />
        </FrameLayout>

        <TextView
            android:id="@id/animeCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Mirai.BodySmall"
            android:textColor="@color/mirai_text_primary"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/animeCardPosterWrap"
            tools:text="Sousou no Frieren" />

        <TextView
            android:id="@id/animeCardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Mirai.Caption"
            app:layout_constraintTop_toBottomOf="@id/animeCardTitle"
            tools:text="TV · 2023" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
