<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirai · main host (V9.xml rebuilt): NavHost + FABs + BottomNav.
  FAB tint fixed (black icons on colored FAB → proper on-color),
  nav height 68dp, active pill = primary 12%.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mirai_bg"
    android:fitsSystemWindows="true">

    <!-- ⚠ استخدم نفس app:navGraph الأصلي من ملفك القديم (مثل app:navGraph="@navigation/main_nav")
         واحذف هذا السطر عند الدمج — لا يمكن تضمينه هنا لأن اسم ملف navigation خاص بمشروعك -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@id/mainFabCreate"
        style="@style/Widget.Mirai.FAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_bottom_offset"
        android:contentDescription="@string/create"
        android:src="@drawable/mirai_ic_add"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
        app:tint="@color/mirai_on_primary" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@id/mainFabSecondary"
        style="@style/Widget.Mirai.FAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_bottom_offset"
        android:contentDescription="@string/create"
        android:visibility="gone"
        android:src="@drawable/mirai_ic_add"
        app:backgroundTint="@color/mirai_secondary"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
        app:tint="@color/mirai_on_secondary" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@id/mainBottomNav"
        style="@style/Widget.Mirai.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:labelVisibilityMode="labeled"
        app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior"
        app:menu="@menu/bottom_nav_menu" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
