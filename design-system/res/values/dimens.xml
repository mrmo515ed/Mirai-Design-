<?xml version="1.0" encoding="utf-8"?>
<!--
  MIRAI DESIGN SYSTEM — DIMENSIONS  v1.0
  4dp base grid. Every margin/padding/gap in the app comes from this scale.
  Audit finding replaced: arbitrary 3dp/5dp/6dp/9dp/10dp/14dp values scattered
  across 49 screens → now 2·4·8·12·16·20·24·32·40 only (grid tightened).
-->
<resources>

    <!-- ═══════════ SPACING SCALE (4dp grid) ═══════════ -->
    <dimen name="space_0">0dp</dimen>
    <dimen name="space_xs">2dp</dimen>      <!-- hairline gaps, chip nudges -->
    <dimen name="space_s">4dp</dimen>       <!-- icon ↔ label -->
    <dimen name="space_sm">8dp</dimen>      <!-- intra-group -->
    <dimen name="space_m">12dp</dimen>      <!-- card inner vertical -->
    <dimen name="space_l">16dp</dimen>      <!-- screen gutter + card padding -->
    <dimen name="space_xl">20dp</dimen>     <!-- section separation -->
    <dimen name="space_xxl">24dp</dimen>    <!-- major section break -->
    <dimen name="space_xxxl">32dp</dimen>   <!-- hero breathing -->
    <dimen name="space_huge">40dp</dimen>   <!-- end-of-scroll -->

    <dimen name="screen_gutter">16dp</dimen>
    <dimen name="screen_gutter_end">24dp</dimen>  <!-- used w/ clipToPadding rails -->

    <!-- ═══════════ RADIUS SCALE (was 14 different values) ═══════════ -->
    <dimen name="radius_xs">6dp</dimen>     <!-- tags, tiny chips, thumbnails -->
    <dimen name="radius_s">8dp</dimen>      <!-- small buttons, inputs chips -->
    <dimen name="radius_m">12dp</dimen>     <!-- standard cards, posters -->
    <dimen name="radius_l">16dp</dimen>     <!-- hero cards, trailer, dialogs -->
    <dimen name="radius_xl">20dp</dimen>    <!-- bottom sheets, big surfaces -->
    <dimen name="radius_full">100dp</dimen> <!-- pills, avatars, FAB -->
    <dimen name="radius_hero">28dp</dimen>  <!-- floating poster card only -->

    <!-- ═══════════ ELEVATION (restrained — borders do the work) ═══════════ -->
    <dimen name="elev_none">0dp</dimen>
    <dimen name="elev_card">2dp</dimen>
    <dimen name="elev_raised">4dp</dimen>
    <dimen name="elev_poster">12dp</dimen>
    <dimen name="elev_sheet">6dp</dimen>
    <dimen name="elev_dialog">8dp</dimen>
    <dimen name="elev_nav">8dp</dimen>

    <!-- ═══════════ COMPONENT SIZES ═══════════ -->
    <!-- Touch targets: NEVER below 44dp (a11y). Old 36dp icon buttons → 44dp. -->
    <dimen name="touch_min">44dp</dimen>
    <dimen name="icon_min">44dp</dimen>
    <dimen name="btn_height">52dp</dimen>
    <dimen name="btn_height_large">56dp</dimen>
    <dimen name="btn_height_small">40dp</dimen>
    <dimen name="input_height">52dp</dimen>

    <!-- Avatars -->
    <dimen name="avatar_xs">28dp</dimen>
    <dimen name="avatar_s">36dp</dimen>
    <dimen name="avatar_m">48dp</dimen>   <!-- list rows, chat -->
    <dimen name="avatar_l">56dp</dimen>   <!-- comments, staff rows -->
    <dimen name="avatar_xl">80dp</dimen>  <!-- profile header -->
    <dimen name="avatar_profile">104dp</dimen>

    <!-- Posters & thumbs (2:3 ratio preserved across the app) -->
    <dimen name="poster_width_s">96dp</dimen>
    <dimen name="poster_height_s">144dp</dimen>
    <dimen name="poster_width_m">110dp</dimen>   <!-- anime details hero -->
    <dimen name="poster_height_m">165dp</dimen>
    <dimen name="poster_width_l">140dp</dimen>   <!-- rails -->
    <dimen name="poster_height_l">210dp</dimen>
    <dimen name="thumb_video">128dp</dimen>
    <dimen name="thumb_episode_w">132dp</dimen>
    <dimen name="thumb_episode_h">76dp</dimen>

    <!-- Hero / cinematic -->
    <dimen name="hero_height">500dp</dimen>
    <dimen name="hero_scrim_height">280dp</dimen>
    <dimen name="hero_poster_elev">12dp</dimen>

    <!-- Bottom navigation -->
    <dimen name="bottom_nav_height">68dp</dimen>
    <dimen name="bottom_nav_label">11sp</dimen>

    <!-- Chips -->
    <dimen name="chip_height">30dp</dimen>
    <dimen name="chip_stroke">1dp</dimen>

    <!-- Dividers -->
    <dimen name="divider">1dp</dimen>

    <!-- Bottom sheet -->
    <dimen name="sheet_handle_width">36dp</dimen>
    <dimen name="sheet_handle_height">4dp</dimen>
    <dimen name="sheet_peek">0dp</dimen>

    <!-- Rating -->
    <dimen name="rating_star">22dp</dimen>
    <dimen name="rating_seek_thumb">20dp</dimen>

    <!-- Stream / misc -->
    <dimen name="status_dot">8dp</dimen>
    <dimen name="badge_min">18dp</dimen>
    <dimen name="fab_size">52dp</dimen>
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="fab_bottom_offset">84dp</dimen>
</resources>
