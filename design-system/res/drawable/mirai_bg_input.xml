<?xml version="1.0" encoding="utf-8"?>
<!-- Text input field -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/mirai_card" />
            <stroke android:width="1.5dp" android:color="@color/mirai_primary" />
            <corners android:radius="@dimen/radius_s" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/mirai_card" />
            <stroke android:width="1dp" android:color="@color/mirai_border" />
            <corners android:radius="@dimen/radius_s" />
        </shape>
    </item>
</selector>
